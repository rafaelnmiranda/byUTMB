# Planilha pública da programação, exportada em CSV.
# Google Sheets → Arquivo → Compartilhar → Publicar na web → CSV
SCHEDULE_CSV_URL="https://docs.google.com/spreadsheets/d/1tsRN2gHLSVr59h3YCTWAXQuVXN8Kc2wqRENCtPTeR_0/export?format=csv"

# Chave da OpenWeatherMap. Gere uma NOVA em https://openweathermap.org/api
# A chave usada no app iOS está exposta no histórico do repositório e deve ser revogada.
# Sem esta variável o app funciona normalmente; só a aba Previsão fica indisponível.
OPENWEATHER_API_KEY=""

# URL pública do site, usada em metadados e nos links compartilhados.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
