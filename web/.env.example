# Planilha pública da programação, exportada em CSV.
# Google Sheets → Arquivo → Compartilhar → Publicar na web → CSV
SCHEDULE_CSV_URL="https://docs.google.com/spreadsheets/d/1Tn6sLvxj5kEQD9l8hZb9BP8dxz1sQzKp/export?format=csv"

# Chave da OpenWeatherMap. Gere uma NOVA em https://openweathermap.org/api
# A chave usada no app iOS está exposta no histórico do repositório e deve ser revogada.
# Sem esta variável o app funciona normalmente; só a aba Previsão fica indisponível.
OPENWEATHER_API_KEY=""

# URL pública do site, usada em metadados e nos links compartilhados.
# Em produção: https://byutmb.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# CSV da aba parceiros (opcional — se omitida, deriva da planilha de programação).
# PARTNERS_CSV_URL="https://docs.google.com/spreadsheets/d/SEU_ID/export?format=csv&gid=1344926349"

# Assinatura dos QRs de resgate (`/p/{slug}?k=`). Em produção, use um segredo próprio.
# Se omitida, cai para ADMIN_PASSWORD (ou fallback de dev).
# REDEEM_SECRET=""

# Janela padrão de validade dos benefícios (Paraty), se a planilha não tiver validFrom/validTo.
# BENEFIT_VALID_FROM="2026-09-17"
# BENEFIT_VALID_TO="2026-09-20"

# Telefone/contato impresso nas folhas de QR dos parceiros.
# PARTNER_SUPPORT_PHONE="+55 …"

# Opcional: webhook para espelhar ativações (métrica agregada, sem PII).
# ACTIVATIONS_WEBHOOK_URL=""

# Senha da área admin (/admin/imagens, /admin/qrs, /admin/resgates). Padrão em dev: byutmb2026
ADMIN_PASSWORD=""

# Em produção o filesystem é read-only (Vercel). Upload só funciona em localhost,
# ou com ADMIN_UPLOADS_ENABLED=true + armazenamento persistente (Blob/S3).
# ADMIN_UPLOADS_ENABLED="true"
